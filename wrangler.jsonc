{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wow-forever-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    "DISCORD_APP_ID": "",
    "DISCORD_PUBLIC_KEY": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "ASKS", "class_name": "Ask" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Ask"] }]
}
